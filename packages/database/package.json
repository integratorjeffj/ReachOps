{
  "name": "@reachops/database",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "prisma generate && vitest run",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "demo:seed": "pnpm build && node dist/src/demo/cli.js seed",
    "demo:reset": "pnpm build && node dist/src/demo/cli.js reset"
  },
  "dependencies": {
    "@reachops/contracts": "workspace:*",
    "@reachops/integrations": "workspace:*",
    "@prisma/client": "6.19.3"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "prisma": "6.19.3",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
