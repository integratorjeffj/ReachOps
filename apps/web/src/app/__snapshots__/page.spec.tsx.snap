// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`HomePage > matches the reviewed foundation structure 1`] = `
<div>
  <div
    class="overview-page"
  >
    <section
      aria-labelledby="overview-title"
      class="hero"
    >
      <div
