{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", "out/**"],
      "env": [
        "REACHOPS_DEMO_MODE",
        "NEXT_PUBLIC_BASE_PATH",
        "API_INTERNAL_URL",
        "DEMO_WORKSPACE_SLUG"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build", "^lint"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "@reachops/database#test": {
      "cache": false,
      "env": ["DATABASE_URL"]
    },
    "@reachops/api#test": {
      "cache": false,
      "env": ["DATABASE_URL"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    }
  }
}
